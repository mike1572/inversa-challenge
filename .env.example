# ── Supabase ─────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # browser-safe, read-only via RLS
SUPABASE_SERVICE_ROLE_KEY=                # SERVER ONLY — never prefix NEXT_PUBLIC_

# Dashboard → Project Settings → Database → Connection string.
# Use the POOLED (Transaction) URI on port 6543 for serverless — the direct 5432
# connection will exhaust its limit under Vercel concurrency.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── Data feeds ───────────────────────────────────────────────────────
FIRMS_MAP_KEY=                            # free: firms.modaps.eosdis.nasa.gov/api/map_key/
OPENAQ_API_KEY=                           # free: explore.openaq.org/register
# Open-Meteo and NWS need no key. NWS rejects requests without a real contact string:
NWS_USER_AGENT=smoke-and-breath/1.0 (you@example.com)

# ── Agent ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5                        # or gpt-5-mini if latency disappoints;
                                          # verify ids at platform.openai.com/docs/models

# ── App ──────────────────────────────────────────────────────────────
INGEST_SECRET=                            # any random string; guards /api/ingest/*
REGION_BBOX=-130,24,-60,60                # North America; west,south,east,north (FIRMS order)
HISTORY_DAYS=7
TIER_A_SENSORS=300                        # sensors given full history backfill
LOD_FIRE_CAP=8000                         # continental-zoom fire cap
